// Add a block, move it along X with the gizmo (snapped), cancel a drag with Esc, undo.
Script(steps: [
    WaitFrames(5),
    Click(Anchor("shapes.block")),
    Assert(ObjectCount(1)),
    Assert(SelectedName("Block 1")),
    Assert(ObjectPosition(name: "Block 1", position: (0.0, 0.5, 0.0), tolerance: 0.001)),
    Click(Anchor("tool.move")),
    Assert(ToolIs("Move")),
    Screenshot(path: "move_gizmo.png", probes: []),
    Remember("before_move"),
    Drag(from: World(Point(1.0, 0.5, 0.0)), to: World(Point(4.0, 0.5, 0.0)), frames: Some(15)),
    WaitIdle,
    Assert(ObjectPosition(name: "Block 1", position: (3.0, 0.5, 0.0), tolerance: 0.01)),
    Assert(HistoryLen(2)),
    Screenshot(path: "moved.png", probes: []),
    Action(Undo),
    Assert(ObjectPosition(name: "Block 1", position: (0.0, 0.5, 0.0), tolerance: 0.001)),
    Assert(SameAs("before_move")),
    Action(Redo),
    Assert(ObjectPosition(name: "Block 1", position: (3.0, 0.5, 0.0), tolerance: 0.01)),
    Assert(SelectedCount(1)),
    Key("Escape"),
    Assert(SelectedCount(0)),
    Key("Escape"),
    Assert(ToolIs("Select")),
])
